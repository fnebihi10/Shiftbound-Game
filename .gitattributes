* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.fbx binary
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.mp4 binary
# Unity .asset includes both YAML and binary payloads. Canonical source hashing
# detects the YAML header; Git must preserve unknown/binary asset bytes.
*.asset -text
